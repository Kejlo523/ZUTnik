<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="?attr/mzBgSurface"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/mzBorderSoft"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/colSubject"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:fontFamily="sans-serif-condensed"
                android:textColor="?attr/mzText"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Programowanie obiektowe" />

            <LinearLayout
                android:id="@+id/gradesContainer"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:gravity="center_vertical|end"
                android:orientation="horizontal" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/metaContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/colType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_grade_type_chip"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textColor="?attr/mzMuted"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Wykład" />

            <TextView
                android:id="@+id/colDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/mzMuted"
                android:textSize="12sp"
                tools:text="2025-11-15" />

            <TextView
                android:id="@+id/colEcts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_grade_type_chip"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textColor="?attr/mzMuted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="5.0 ECTS"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/colDistribution"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/grades_distribution_title"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="36dp"
                android:padding="0dp"
                android:textAllCaps="false"
                android:visibility="gone"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_chart_bars"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="16dp"
                app:iconTint="?attr/mzPrimary"
                app:strokeColor="?attr/mzPrimary"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
